# Server config
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

# DB config
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=observv

# App config
APP_ENVIRONMENT=local
APP_LOG_LEVEL=debug

# Seed config
SEED_TERMINALS=10

# Simulator config
SIMULATOR_API_URL=http://127.0.0.1:8080
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_STATUS_FLIP_CHANCE=0.1 # chance per tick that a terminal goes online or offline
SIMULATOR_MAX_TRANSFER_BYTES=100000000 # 100 MB

# OTel config (traces, metrics and logs over OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317 # not localhost
# OTEL_SDK_DISABLED=true # runs the app without a collector
OTEL_METRIC_EXPORT_INTERVAL=15000 # ms, read by the OTel SDK

# Chaos config (change it while the api runs with POST /api/chaos)
CHAOS_LATENCY_MS=0 # added to each /api/terminals request, max 5000
CHAOS_ERROR_RATE=0 # chance per /api/terminals request of a 500

# Compose config (passwords are read only on the first start, change them before you deploy)
POSTGRES_USER=postgres # must match DATABASE_USER
POSTGRES_PASSWORD=postgres # must match DATABASE_PASSWORD
POSTGRES_DB=observv # must match DATABASE_NAME
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
DOMAIN=localhost # Grafana runs on grafana.$DOMAIN with make prod-up
# TRAEFIK_EMAIL=you@example.com # Let's Encrypt contact, optional
